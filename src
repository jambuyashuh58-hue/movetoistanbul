// src/App.jsx
import { Toaster } from "@/components/ui/toaster"
import { QueryClientProvider } from '@tanstack/react-query'
import { queryClientInstance } from '@/lib/query-client'
import { BrowserRouter as Router, Route, Routes } from 'react-router-dom';
import PageNotFound from './lib/PageNotFound';
import { AuthProvider, useAuth } from '@/lib/AuthContext';
import UserNotRegisteredError from '@/components/UserNotRegisteredError';
import ScrollToTop from './components/ScrollToTop';
// Add page imports here
import Home from '@/pages/Home';
import Onboarding from '@/pages/Onboarding';
import RelocationQuiz from '@/pages/RelocationQuiz';
import Discover from '@/pages/Discover';
import ActivityDetail from '@/pages/ActivityDetail';
import Dashboard from '@/pages/Dashboard';
import Itinerary from '@/pages/Itinerary';
import Collections from '@/pages/Collections';
import CollectionDetail from '@/pages/CollectionDetail';
import CityDetail from '@/pages/CityDetail';
import Guides from '@/pages/Guides';
import GuideVisa from '@/pages/GuideVisa';
import GuideHousing from '@/pages/GuideHousing';
import GuideCostOfLiving from '@/pages/GuideCostOfLiving';
import ConciergeService from '@/pages/ConciergeService';
import ConciergeStatus from '@/pages/ConciergeStatus';
import About from '@/pages/About';
import Contact from '@/pages/Contact';
import CharacterStudio from '@/pages/CharacterStudio';
import InstagramStudio from '@/pages/InstagramStudio';
import AdminCollections from '@/pages/AdminCollections';
import AdminActivities from '@/pages/AdminActivities';
import ThreadsStudio from '@/pages/ThreadsStudio';
import ViatorImport from '@/pages/ViatorImport';
import CountryGuides from '@/pages/CountryGuides';
import CountryGuideDetail from '@/pages/CountryGuideDetail';
import Login from '@/pages/Login';
import Register from '@/pages/Register';
import ForgotPassword from '@/pages/ForgotPassword';
import ResetPassword from '@/pages/ResetPassword';
import OAuthConsent from '@/pages/OAuthConsent';
import Layout from '@/components/Layout';

const AuthenticatedApp = () => {
  const { isLoadingAuth, isLoadingPublicSettings, authError, navigateToLogin } = useAuth();

  // Show loading spinner while checking app public settings or auth
  if (isLoadingPublicSettings || isLoadingAuth) {
    return (
      <div className="fixed inset-0 flex items-center justify-center">
        <div className="w-8 h-8 border-4 border-slate-200 border-t-slate-800 rounded-full animate-spin"></div>
      </div>
    );
  }

  // Handle authentication errors
  if (authError) {
    if (authError.type === 'user_not_registered') {
      return <UserNotRegisteredError />;
    } else if (authError.type === 'auth_required') {
      // Redirect to login automatically
      navigateToLogin();
      return null;
    }
  }

  // Render the main app
  return (
    <Routes>
      {/* Add your page Route elements here */}
        <Route element={<Layout />}>
          <Route path="/" element={<Home />} />
          <Route path="/discover" element={<Discover />} />
          <Route path="/activity/:id" element={<ActivityDetail />} />
          <Route path="/collections" element={<Collections />} />
          <Route path="/collections/:slug" element={<CollectionDetail />} />
          <Route path="/city/:cityName" element={<CityDetail />} />
          <Route path="/guides" element={<Guides />} />
          <Route path="/guides/visa" element={<GuideVisa />} />
          <Route path="/guides/housing" element={<GuideHousing />} />
          <Route path="/guides/cost-of-living" element={<GuideCostOfLiving />} />
          <Route path="/concierge" element={<ConciergeService />} />
          <Route path="/concierge/status/:token" element={<ConciergeStatus />} />
          <Route path="/about" element={<About />} />
          <Route path="/contact" element={<Contact />} />
          <Route path="/dashboard" element={<Dashboard />} />
          <Route path="/itinerary" element={<Itinerary />} />
          <Route path="/character-studio" element={<CharacterStudio />} />
          <Route path="/instagram-studio" element={<InstagramStudio />} />
          <Route path="/admin/collections" element={<AdminCollections />} />
          <Route path="/admin/activities" element={<AdminActivities />} />
          <Route path="/admin/viator" element={<ViatorImport />} />
          <Route path="/threads-studio" element={<ThreadsStudio />} />
          <Route path="/country-guides" element={<CountryGuides />} />
          <Route path="/country-guides/:slug" element={<CountryGuideDetail />} />
        </Route>
        <Route path="/onboarding" element={<Onboarding />} />
        <Route path="/relocation-quiz" element={<RelocationQuiz />} />
        <Route path="/login" element={<Login />} />
        <Route path="/register" element={<Register />} />
        <Route path="/forgot-password" element={<ForgotPassword />} />
        <Route path="/reset-password" element={<ResetPassword />} />
        <Route path="/oauth/consent" element={<OAuthConsent />} />
        <Route path="*" element={<PageNotFound />} />
    </Routes>
  );
};


function App() {

  return (
    <AuthProvider>
      <QueryClientProvider client={queryClientInstance}>
        <Router>
          <ScrollToTop />
          <AuthenticatedApp />
        </Router>
        <Toaster />
      </QueryClientProvider>
    </AuthProvider>
  )
}

export default App
